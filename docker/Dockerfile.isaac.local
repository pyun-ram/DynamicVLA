# Alternative Isaac image when NGC nvcr.io is unavailable (mirrors bare-metal binary install).
# Downloads Isaac Sim 4.5.0 standalone zip during build (~7GB+). Very slow; prefer Dockerfile.isaac + nvcr.io.
#
# Build:
#   docker build -f docker/Dockerfile.isaac.local -t dynamicvla-isaac:local .
#
# You can override the zip URL if NVIDIA CDN changes:
#   docker build --build-arg ISAACSIM_ZIP_URL=... -f docker/Dockerfile.isaac.local .

ARG UBUNTU_IMAGE=ubuntu:22.04
FROM ${UBUNTU_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    CONDA_DIR=/opt/conda \
    ISAACSIM_PATH=/opt/isaacsim \
    ISAACLAB_PATH=/opt/IsaacLab \
    ISAACLAB_CLONE_TAG=v2.2.1 \
    OMNI_KIT_ACCEPT_EULA=YES

ARG ISAACSIM_ZIP_URL=https://download.isaacsim.omniverse.nvidia.com/isaac-sim-standalone-4.5.0-linux-x86_64.zip

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git wget unzip bzip2 \
    libgl1 libglib2.0-0 libvulkan1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -o /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p "${CONDA_DIR}" \
    && rm /tmp/miniconda.sh \
    && "${CONDA_DIR}/bin/conda" config --set auto_activate_base false

RUN mkdir -p /tmp/isaac_dl && \
    curl -fL -C - -o /tmp/isaac_dl/isaac-sim.zip "${ISAACSIM_ZIP_URL}" && \
    unzip -q /tmp/isaac_dl/isaac-sim.zip -d /opt && \
    rm -rf /tmp/isaac_dl && \
  ( [ -d "${ISAACSIM_PATH}" ] || mv /opt/isaac-sim* "${ISAACSIM_PATH}" )

RUN git clone --depth 1 --branch "${ISAACLAB_CLONE_TAG}" \
    https://github.com/isaac-sim/IsaacLab.git "${ISAACLAB_PATH}" \
    || (git clone --depth 1 https://github.com/isaac-sim/IsaacLab.git "${ISAACLAB_PATH}" \
        && cd "${ISAACLAB_PATH}" && git checkout "${ISAACLAB_CLONE_TAG}")

WORKDIR /workspace/DynamicVLA
COPY requirements-isaac.txt /workspace/DynamicVLA/requirements-isaac.txt
COPY docker/scripts/setup_isaaclab_conda.sh /opt/setup_isaaclab_conda.sh
RUN chmod +x /opt/setup_isaaclab_conda.sh && /opt/setup_isaaclab_conda.sh

RUN echo 'source /opt/conda/etc/profile.d/conda.sh && conda activate isaaclab' >> /etc/bash.bashrc
ENV PATH=/opt/conda/envs/isaaclab/bin:${PATH}
CMD ["/bin/bash"]
